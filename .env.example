# Copy this file to .env and replace placeholder values before running the bot.
# Do not commit .env to Git.

# Telegram bot from @BotFather.
BOT_TOKEN=replace_with_botfather_token

# Public HTTPS base URL for Telegram webhook.
# For local demo use the HTTPS URL from: ngrok http 80
WEBHOOK_BASE_URL=https://example.ngrok-free.app
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_random_webhook_secret

# Telegram identifiers. Get them from @userinfobot.
ADMIN_TELEGRAM_ID=replace_with_admin_telegram_id
OWNER_TELEGRAM_ID=replace_with_owner_telegram_id
OPERATOR_GROUP_ID=replace_with_operator_group_id

# PostgreSQL used by docker-compose.yml.
POSTGRES_USER=botuser
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=botdb
DATABASE_URL=postgresql+asyncpg://botuser:replace_with_local_database_password@db:5432/botdb

# Redis used for FSM state storage.
REDIS_URL=redis://redis:6379/0

# Optional fallback values. Business settings are stored in bot_settings
# and can be changed by the owner from Telegram after startup.
SUPPORT_CONTACT=
OPERATOR_PAYOUT_PERCENT=70
ADMIN_PAYOUT_PERCENT=100

# Robokassa is optional. Leave these values empty for manual payment mode:
# the client reports payment and the administrator confirms it manually.
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
ROBOKASSA_IS_TEST=true
